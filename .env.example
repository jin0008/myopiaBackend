# Database
DATABASE_URL=

# Google Cloud KMS (field encryption)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION_ID=
GOOGLE_CLOUD_KEY_RING_ID=
GOOGLE_CLOUD_CRYPTO_KEY_ID=

# SMTP (threshold alert emails). Leave blank to disable outgoing email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 답장 받을 주소. 발신은 도메인 인증된 no-reply 로 나가고, 회신만 여기로 온다.
SMTP_REPLY_TO=

# Audit log retention in days for scripts/purge-old-audit-logs (default 730 = 2 years).
AUDIT_LOG_RETENTION_DAYS=730

# Kakao Local API (병원/기관 찾기). REST API key from Kakao Developers → 앱 키.
# The app's 보안 → 허용 IP 주소 list must include this server's public IP, or
# Kakao answers 403 and every facility search fails.
KAKAO_REST_API_KEY=

# --- 소셜 로그인 검증 (src/lib/socialAuth.ts) ---
# 앱이 보낸 토큰을 서버가 각 제공자에게 대조할 때 쓴다. 비어 있으면 해당
# 제공자로 로그인한 사람은 500 을 받는다 — 앱에서는 "로그인 실패"로만 보인다.

# 애플. 앱의 bundle identifier 와 정확히 같아야 한다(현재 org.myopiamanage.myodoc).
# identityToken 의 audience 를 이 값과 대조하므로 틀리면 전부 거절된다.
APPLE_BUNDLE_ID=

# 구글. iOS 네이티브 로그인이 발급한 id_token 의 audience.
GOOGLE_IOS_CLIENT_ID=
# 구글 웹(myodoc.co.kr) 로그인의 audience. 웹 로그인을 쓰면 채운다.
GOOGLE_CLIENT_ID=

# 카카오 웹 로그인. 인가 코드를 토큰으로 바꿀 때 KAKAO_REST_API_KEY 와 함께 쓴다.
# 콘솔 → 카카오 로그인 → 보안 → Client Secret 이 켜져 있으면 반드시 채운다.
KAKAO_CLIENT_SECRET=

# 광고 한 달 값(원). 행정동 하나를 한 달 독점하는 값이다.
# 비워 두면 결제창이 열리지 않는다 - 기본값으로 긁는 사고를 막는다.
SUBSCRIPTION_MONTHLY_AMOUNT=

# 나이스페이먼츠. 키는 가맹점 관리자에서 받는다.
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
# 비우면 운영. 테스트 상점이면 https://sandbox-api.nicepay.co.kr
NICEPAY_BASE_URL=
# 정기결제(빌링). 나이스가 결제 경로 심사 후 열어 준 뒤에 1 로 켠다.
NICEPAY_BILLING_ENABLED=
